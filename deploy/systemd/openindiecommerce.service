[Unit]
Description=OpenIndieCommerce Commerce Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openindiecommerce
Group=openindiecommerce
EnvironmentFile=/etc/openindiecommerce/openindiecommerce.env
ExecStart=/opt/openindiecommerce/bin/openindiecommerce-server
Restart=on-failure
RestartSec=3
WorkingDirectory=/var/lib/openindiecommerce
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/openindiecommerce
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
